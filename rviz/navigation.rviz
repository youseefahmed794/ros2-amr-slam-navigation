Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
      Plane Cell Count: 50
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Value: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
      Show Names: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Value: true
      Topic:
        Value: /scan
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/Map
      Name: Global Map
      Value: true
      Topic:
        Value: /map
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Value: true
      Topic:
        Value: /local_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Value: false
      Topic:
        Value: /global_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.3
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Value: true
      Topic:
        Value: /plan
      Color: 0; 255; 0
      Line Style: Billboards
      Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Value: true
      Topic:
        Value: /local_plan
      Color: 255; 255; 0
      Line Style: Billboards
      Width: 0.02
    - Class: rviz_default_plugins/PoseArray
      Name: AMCL Particles
      Value: true
      Topic:
        Value: /particle_cloud
      Arrow Length: 0.05
      Color: 0; 180; 255
    - Class: rviz_default_plugins/Marker
      Name: Waypoints
      Value: true
      Topic:
        Value: /waypoint_markers
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Scale: 15
      X: 0
      Y: 0
